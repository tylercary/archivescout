# ─────────────────────────────────────────────────────────────
# ArchiveScout environment variables
# Copy this file to `.env.local` and fill in values as you integrate.
# The app runs fully with MOCK data even if every value below is blank.
# ─────────────────────────────────────────────────────────────

# --- Data source toggle -------------------------------------------------
# mock (default) local mock listings, no network — the app runs with zero setup.
# live           real feeds via the *_API_BASE / *_API_KEY values below; any
#                marketplace missing credentials falls back to mock.
DATA_SOURCE=mock

# --- Supabase (auth + saved searches + favorites) -----------------------
# Safe to expose to the browser (public anon key / project URL):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the browser:
SUPABASE_SERVICE_ROLE_KEY=

# --- eBay Browse API (server-only) — FULLY IMPLEMENTED ------------------
# The one official, ToS-compliant marketplace integration. Set DATA_SOURCE=live
# plus the two credentials below and eBay goes live immediately.
# Get keys: https://developer.ebay.com  (Application Keys -> App ID / Cert ID)
# Docs: https://developer.ebay.com/api-docs/buy/browse/overview.html
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production          # or "sandbox"
EBAY_MARKETPLACE_ID=EBAY_US  # EBAY_GB, EBAY_DE, ...


# --- Grailed ------------------------------------------------------------
# Grailed has no public API. Requires an approved data partnership.
# See docs/INTEGRATION.md. Leave blank to use mock data.
GRAILED_API_BASE=
GRAILED_API_KEY=

# ─── eBay Marketplace Account Deletion (required to enable Production keys) ──
# eBay calls a PUBLIC, UNAUTHENTICATED endpoint to verify ownership and to send
# account-deletion notifications:  /api/ebay/account-deletion
#
# Token: 32-80 chars, alphanumeric. Must match the eBay Developer Portal value.
# Endpoint: must byte-for-byte match the URL registered in the portal (scheme,
# host, path, casing, trailing slash) — it is part of the SHA-256 challenge.
# Neither var may be exposed via NEXT_PUBLIC_.
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=https://your-domain.example.com/api/ebay/account-deletion

# ─── Saved-search alerts (the sweep + email digests) ─────────────────────
# Alerts stay OFF until every one of these is set AND the flag is true. The UI
# shows "Coming soon" and disables the toggles until then, so users are never
# told an alert will arrive when nothing can send it.
SAVED_SEARCH_ALERTS_ENABLED=false
# Mirror of the flag for the browser (controls the UI state only).
NEXT_PUBLIC_SAVED_SEARCH_ALERTS_ENABLED=false
# SERVER-ONLY. Bypasses RLS — never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>`.
ALERT_CRON_SECRET=
# Email delivery (Resend).
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
