# ArchiveScout marketplace adapter — configuration
# Run:  cp .env.example .env  (values below are read from the shell environment)

# Port the adapter listens on.
PORT=8787

# If set, incoming requests must send  Authorization: Bearer <ADAPTER_API_KEY>.
# Use the SAME value for GRAILED_API_KEY in the main app's .env.local.
ADAPTER_API_KEY=local-dev-key

